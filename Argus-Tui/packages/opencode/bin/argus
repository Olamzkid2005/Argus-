#!/usr/bin/env bun
/**
 * Argus Security CLI — V5
 *
 * Runs the Argus TypeScript entry point directly via Bun.
 * Usage: argus <command> [options]
 *        argus doctor
 *        argus assess https://example.com
 *        argus --help
 *
 * Note: This wrapper intentionally does NOT chdir or override the child's
 * working directory. This preserves the user's original CWD so that CLI
 * commands (assess, report, doctor) can find argus.config.yaml and resolve
 * relative paths correctly.
 */
import { fileURLToPath } from "url"
import { dirname, join } from "path"
import { spawnForeground } from "../src/argus/launcher"

// Use absolute path so bun resolves the entry regardless of CWD
const binDir = dirname(fileURLToPath(import.meta.url))
const entry = join(binDir, "..", "src", "argus", "index.ts")

// Re-exec via bun with the argus entry point, preserving all args.
// Uses process.execPath instead of the bare string "bun" so that we don't
// depend on bun being on PATH for spawned children — process.execPath is
// the full path to the current bun interpreter that is running this script.
spawnForeground(process.execPath, ["run", entry, ...process.argv.slice(2)], {
  stdio: "inherit",
})
